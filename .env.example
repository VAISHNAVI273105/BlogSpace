# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For Local MongoDB: mongodb://127.0.0.1:27017/blogspace
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/blogspace?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/blogspace

# JWT Authentication Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
